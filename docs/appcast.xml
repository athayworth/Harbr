<?xml version="1.0" encoding="utf-8"?>
<!--
    Template for the Sparkle appcast feed Harbr will read.

    Host this file at the URL you set in Resources/Info.plist's SUFeedURL
    (e.g. GitHub Pages: https://athayworth.github.io/Harbr/appcast.xml).

    Per release, append a new <item> at the top with:

      <title>             — version label shown in the updater UI
      <pubDate>           — RFC 822 date, e.g. "Thu, 06 Jun 2026 15:00:00 -0400"
      <sparkle:version>   — must match CFBundleVersion in Info.plist for
                            that release
      <sparkle:shortVersionString> — matches CFBundleShortVersionString
      <enclosure url>     — direct URL to the notarized Harbr.app.zip on
                            GitHub Releases for that tag
      <enclosure sparkle:edSignature>
                          — sign the zip with the EdDSA private key:
                              ./bin/sign_update path/to/Harbr.app.zip
                            and paste the printed signature in here
      <enclosure length>  — byte length of the zip (Sparkle uses it for the
                            progress bar): `stat -f %z Harbr.app.zip`

    `description` can be the corresponding release notes from CHANGELOG.md,
    rendered as HTML inside CDATA.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
    <channel>
        <title>Harbr</title>
        <link>https://github.com/athayworth/Harbr</link>
        <description>Updates for Harbr — the menu bar dev-server cockpit.</description>
        <language>en</language>

        <!--
